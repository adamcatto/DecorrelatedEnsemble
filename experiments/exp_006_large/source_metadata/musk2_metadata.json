e","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f138","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f139","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f140","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f141","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f142","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f143","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f144","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f145","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f146","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f147","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f148","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f149","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f150","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f151","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f152","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f153","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f154","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f155","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f156","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f157","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f158","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f159","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f160","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f161","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f162","role":"Feature","type":"Integer","demographic":null,"description":null,"units":null,"missing_values":"no"},{"name":"f163","role":"Feature","type":"Integer","demographic":null,"description":"This is the distance of the oxygen atom in the molecule to a designated point in 3-space. This is also called OXY-DIS.","units":null,"missing_values":"no"},{"name":"f164","role":"Feature","type":"Integer","demographic":null,"description":"OXY-Z: X-displacement from the designated point.","units":null,"missing_values":"no"},{"name":"f165","role":"Feature","type":"Integer","demographic":null,"description":"OXY-Z: Y-displacement from the designated point.","units":null,"missing_values":"no"},{"name":"f166","role":"Feature","type":"Integer","demographic":null,"description":"OXY-Z: Z-displacement from the designated point.","units":null,"missing_values":"no"},{"name":"class","role":"Target","type":"Continuous","demographic":null,"description":"0 => non-musk, 1 => musk","units":null,"missing_values":"no"}],"additional_info":{"summary":"This dataset describes a set of 102 molecules of which 39 are judged by human experts to be musks and the remaining 63 molecules are judged to be non-musks.  The goal is to learn to predict whether new molecules will be musks or non-musks.  However, the 166 features that describe these molecules depend upon the exact shape, or conformation, of the molecule.  Because bonds can rotate, a single molecule can adopt many different shapes.  To generate this data set, all the low-energy conformations of the molecules were generated to produce 6,598 conformations.  Then, a feature vector was extracted that describes each conformation. \r\n\r\nThis many-to-one relationship between feature vectors and molecules is called the \"multiple instance problem\".  When learning a classifier for this data, the classifier should classify a molecule as \"musk\" if ANY of its conformations is classified as a musk.  A molecule should be classified as \"non-musk\" if NONE of its conformations is classified as a musk.","purpose":null,"funded_by":null,"instances_represent":null,"recommended_data_splits":null,"sensitive_data":null,"preprocessing_description":null,"variable_info":"   molecule_name:       Symbolic name of each molecule.  Musks have names such as MUSK-188.  Non-musks have names such as NON-MUSK-jp13.\r\n   conformation_name:   Symbolic name of each conformation.  These have the format MOL_ISO+CONF, where MOL is the molecule number, ISO is the stereoisomer number (usually 1), and CONF is the conformation number. \r\n   f1 through f162:     These are \"distance features\" along rays (see paper cited above).  The distances are measured in hundredths of Angstroms.  The distances may be negative or positive, since they are actually measured relative to an origin placed along each ray.  The origin was defined by a \"consensus musk\" surface that is no longer used.  Hence, any experiments with the data should treat these feature values as lying on an arbitrary continuous scale.  In particular, the algorithm should not make any use of the zero point or the sign of each feature value. \r\n   f163:                This is the distance of the oxygen atom in the molecule to a designated point in 3-space. This is also called OXY-DIS.\r\n   f164:                OXY-X: X-displacement from the designated point.\r\n   f165:                OXY-Y: Y-displacement from the designated point.\r\n   f166:                OXY-Z: Z-displacement from the designated point. \r\n   class:               0 => non-musk, 1 => musk\r\n\r\n   Please note that the molecule_name and conformation_name attributes should not be used to predict the class.","citation":null}}}